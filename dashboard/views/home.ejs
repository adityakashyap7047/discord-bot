  </footer>

  <script>
    // LOADING SCREEN
    window.addEventListener('load', function() {
      setTimeout(function() { document.getElementById('loader').classList.add('hidden'); }, 1500);
    });

    // SCROLL PROGRESS
    window.addEventListener('scroll', function() {
      var scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
      var scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      var progress = (scrollTop / scrollHeight) * 100;
      document.getElementById('scrollProgress').style.width = progress + '%';
    });

    // MOUSE SPOTLIGHT + CURSOR GLOW
    var spotlight = document.getElementById('spotlight');
    var cursorGlow = document.getElementById('cursorGlow');
    document.addEventListener('mousemove', function(e) {
      if (spotlight) { spotlight.style.left = e.clientX + 'px'; spotlight.style.top = e.clientY + 'px'; }
      if (cursorGlow) { cursorGlow.style.left = e.clientX + 'px'; cursorGlow.style.top = e.clientY + 'px'; }
    });

    // 3D TILT EFFECT ON CARDS
    document.querySelectorAll('[data-tilt], .feat-card, .feat, .step, .test-card').forEach(function(card) {
      card.addEventListener('mousemove', function(e) {
        var rect = card.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var centerX = rect.width / 2;
        var centerY = rect.height / 2;
        var rotateX = (y - centerY) / 20;
        var rotateY = (centerX - x) / 20;
        card.style.transform = 'perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateZ(10px)';
      });
      card.addEventListener('mouseleave', function() {
        card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateZ(0)';
      });
    });

    // DNA HELIX
    var dnaContainer = document.getElementById('dnaHelix');
    if (dnaContainer) {
      for (var d = 0; d < 20; d++) {
        var dot = document.createElement('div');
        dot.className = 'dna-dot';
        dot.style.top = (d * 20) + 'px';
        dot.style.animationDelay = (d * 0.15) + 's';
        dot.style.opacity = (1 - d * 0.04);
        dnaContainer.appendChild(dot);
      }
    }

    // STATS
    fetch('/api/stats').then(function(r){return r.json()}).then(function(d){
      animateCounter('g', d.guilds);
      animateCounter('u', d.users, true);
      animateCounter('c', d.commands);
      animateCounter('sg', d.guilds);
      animateCounter('su', d.users, true);
      animateCounter('sc', d.commands);
      var sg = document.getElementById('statusGuilds');
      var stG = document.getElementById('st-guilds');
      var stC = document.getElementById('st-cmds');
      var hudN = document.getElementById('hud-nodes');
      if (sg) sg.textContent = d.guilds;
      if (stG) stG.textContent = d.guilds;
      if (stC) stC.textContent = d.commands;
      if (hudN) hudN.textContent = d.commands;
    });

    // LIVE STATUS
    function refreshStatus() {
      fetch('/api/bot/health').then(function(r){return r.json()}).then(function(d){
        var sP = document.getElementById('statusPing');
        var sM = document.getElementById('statusMemory');
        var sU = document.getElementById('statusUptime');
        var stPing = document.getElementById('st-ping');
        var stPingBar = document.getElementById('st-ping-bar');
        var stMem = document.getElementById('st-mem');
        var stMemBar = document.getElementById('st-mem-bar');
        var hudPing = document.getElementById('hud-ping');
        var memMB = Math.round(d.memory.heap / 1024 / 1024);
        var uptime = d.uptime;
        var sec = Math.floor(uptime / 1000);
        var min = Math.floor(sec / 60);
        var hrs = Math.floor(min / 60);
        if (sP) sP.textContent = d.ping + 'ms';
        if (sM) sM.textContent = memMB + 'MB';
        if (sU) sU.textContent = hrs + 'h ' + (min % 60) + 'm';
        if (stPing) stPing.textContent = d.ping;
        if (stPingBar) stPingBar.style.width = Math.min(d.ping / 2, 100) + '%';
        if (stMem) stMem.textContent = memMB + 'MB';
        if (stMemBar) stMemBar.style.width = Math.min(d.memory.heap / d.memory.total * 100, 100) + '%';
        if (hudPing) hudPing.textContent = d.ping;
        // HUD uptime
        var dd = Math.floor(sec / 86400);
        var hh = Math.floor((sec % 86400) / 3600);
        var mm = Math.floor((sec % 3600) / 60);
        var ss = sec % 60;
        var hudU = document.getElementById('hud-uptime');
        var liveU = document.getElementById('live-uptime');
        if (hudU) hudU.textContent = hh.toString().padStart(2,'0') + ':' + mm.toString().padStart(2,'0') + ':' + ss.toString().padStart(2,'0');
        if (liveU) liveU.textContent = dd + 'd ' + hh + 'h ' + mm + 'm ' + ss + 's';
      }).catch(function(){});
    }
    refreshStatus();
    setInterval(refreshStatus, 30000);

    function animateCounter(id, target, comma) {
      var el = document.getElementById(id);
      if (!el) return;
      var duration = 2000;
      var start = performance.now();
      function update(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.floor(target * eased);
        el.textContent = comma ? current.toLocaleString() : current;
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }

    // COMMAND SEARCH
    var allCommands = [
      {n:'ban',d:'Ban a user from the server',c:'Moderation'},{n:'kick',d:'Kick a user from the server',c:'Moderation'},
      {n:'mute',d:'Mute a user for a duration',c:'Moderation'},{n:'unmute',d:'Unmute a user',c:'Moderation'},
      {n:'warn',d:'Warn a user',c:'Moderation'},{n:'warnings',d:'View user warnings',c:'Moderation'},
      {n:'purge',d:'Delete messages in bulk',c:'Moderation'},{n:'nick',d:'Change a user nickname',c:'Moderation'},
      {n:'slowmode',d:'Set channel slowmode',c:'Moderation'},{n:'lock',d:'Lock a channel',c:'Moderation'},
      {n:'unlock',d:'Unlock a channel',c:'Moderation'},{n:'tempban',d:'Temporarily ban a user',c:'Moderation'},
      {n:'massban',d:'Ban multiple users at once',c:'Moderation'},
      {n:'antiscam',d:'Configure anti-scam protection',c:'Security'},{n:'verification',d:'Setup verification system',c:'Security'},
      {n:'raid',d:'Configure raid protection',c:'Security'},
      {n:'balance',d:'Check your coin balance',c:'Economy'},{n:'daily',d:'Claim daily reward',c:'Economy'},
      {n:'work',d:'Work to earn coins',c:'Economy'},{n:'shop',d:'View the item shop',c:'Economy'},
      {n:'buy',d:'Buy an item from shop',c:'Economy'},{n:'pay',d:'Pay coins to another user',c:'Economy'},
      {n:'rob',d:'Rob another user',c:'Economy'},{n:'leaderboard',d:'View economy leaderboard',c:'Economy'},
      {n:'setup',d:'Quick setup wizard',c:'Setup'},{n:'setwelcome',d:'Set welcome channel & message',c:'Setup'},
      {n:'setgoodbye',d:'Set goodbye channel & message',c:'Setup'},{n:'setlog',d:'Set mod log channel',c:'Setup'},
      {n:'setprefix',d:'Change bot prefix',c:'Setup'},{n:'setautorole',d:'Set auto-role for new members',c:'Setup'},
      {n:'automod',d:'Configure auto-moderation',c:'Setup'},
      {n:'ping',d:'Check bot latency',c:'Utility'},{n:'help',d:'Show all commands',c:'Utility'},
      {n:'avatar',d:'Get user avatar',c:'Utility'},{n:'userinfo',d:'Get user information',c:'Utility'},
{n:'serverinfo',d:'Get server information',c:'Utility'},{n:'poll',d:'Create a poll',c:'Utility'},
      {n:'remind',d:'Set a reminder',c:'Utility'},{n:'msg',d:'Send message to a channel',c:'Utility'},
      {n:'weather',d:'Get weather info',c:'Utility'},{n:'base64',d:'Encode/decode base64',c:'Utility'},
      {n:'8ball',d:'Ask the magic 8-ball',c:'Fun'},{n:'roll',d:'Roll a dice',c:'Fun'},
      {n:'decide',d:'Let bot decide for you',c:'Fun'},{n:'say',d:'Bot says your message',c:'Fun'},
      {n:'reverse',d:'Reverse your text',c:'Fun'},{n:'coinflip',d:'Flip a coin',c:'Fun'},
      {n:'trivia',d:'Play trivia game',c:'Fun'},{n:'slot',d:'Play slot machine',c:'Fun'},
      {n:'meme',d:'Get a random meme',c:'Fun'},{n:'roast',d:'Roast a user',c:'Fun'},
      {n:'hack',d:'Fake hack a user',c:'Fun'},{n:'clap',d:'CLAP your text',c:'Fun'},
      {n:'ticket',d:'Setup ticket system',c:'Tickets'},{n:'giveaway',d:'Start a giveaway',c:'Giveaways'},
      {n:'addcommand',d:'Create a custom command',c:'Custom'},{n:'removecommand',d:'Delete a custom command',c:'Custom'},
      {n:'listcommands',d:'List all custom commands',c:'Custom'},{n:'reactionrole',d:'Setup reaction roles',c:'Custom'},
    ];

    var searchInput = document.getElementById('cmdSearch');
    var resultsDiv = document.getElementById('cmdResults');
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        var q = this.value.toLowerCase().trim();
        if (!q) { resultsDiv.classList.remove('show'); resultsDiv.innerHTML = ''; return; }
        var matches = allCommands.filter(function(c) { return c.n.includes(q) || c.d.toLowerCase().includes(q) || c.c.toLowerCase().includes(q); }).slice(0, 9);
        if (matches.length === 0) { resultsDiv.classList.remove('show'); return; }
        resultsDiv.innerHTML = matches.map(function(c) {
          return '<div class="cmd-result" onclick="document.getElementById(\'cmdSearch\').value=\'' + c.n + '\';document.getElementById(\'cmdResults\').classList.remove(\'show\')"><div class="cmd-name">/' + c.n + '</div><div class="cmd-desc">' + c.d + ' &middot; ' + c.c + '</div></div>';
        }).join('');
        resultsDiv.classList.add('show');
      });
    }

    // MATRIX RAIN
    var mc = document.getElementById('matrix-canvas');
    var mctx = mc.getContext('2d');
    mc.width = window.innerWidth;
    mc.height = window.innerHeight;
    var chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
    var fontSize = 14;
    var columns = Math.floor(mc.width / fontSize);
    var drops = Array(columns).fill(1);
    function drawMatrix() {
      mctx.fillStyle = 'rgba(3,3,8,0.04)';
      mctx.fillRect(0, 0, mc.width, mc.height);
      mctx.font = fontSize + 'px monospace';
      for (var i = 0; i < drops.length; i++) {
        var text = chars[Math.floor(Math.random() * chars.length)];
        mctx.fillStyle = Math.random() > 0.98 ? '#00f0ff' : Math.random() > 0.95 ? '#ec4899' : '#8b5cf6';
        mctx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > mc.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }
    setInterval(drawMatrix, 50);

    // PARTICLES (mouse reactive)
    var pc = document.getElementById('particle-canvas');
    var pctx = pc.getContext('2d');
    pc.width = window.innerWidth;
    pc.height = window.innerHeight;
    var particles = [];
    var mouseX = 0, mouseY = 0;
    document.addEventListener('mousemove', function(e) { mouseX = e.clientX; mouseY = e.clientY; });
    for (var i = 0; i < 80; i++) {
      particles.push({
        x: Math.random() * pc.width,
        y: Math.random() * pc.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        r: Math.random() * 2 + 0.5,
        color: ['#00f0ff', '#8b5cf6', '#ec4899'][Math.floor(Math.random() * 3)],
      });
    }
    function drawParticles() {
      pctx.clearRect(0, 0, pc.width, pc.height);
      particles.forEach(function(p, i) {
        var dx = mouseX - p.x;
        var dy = mouseY - p.y;
        var dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 200) { p.x += dx * 0.001; p.y += dy * 0.001; }
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = pc.width;
        if (p.x > pc.width) p.x = 0;
        if (p.y < 0) p.y = pc.height;
        if (p.y > pc.height) p.y = 0;
        pctx.beginPath();
        pctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        pctx.fillStyle = p.color;
        pctx.globalAlpha = 0.5;
        pctx.fill();
        pctx.globalAlpha = 0.08;
        for (var j = i + 1; j < particles.length; j++) {
          var ddx = p.x - particles[j].x;
          var ddy = p.y - particles[j].y;
          var ddist = Math.sqrt(ddx * ddx + ddy * ddy);
          if (ddist < 120) {
            pctx.beginPath();
            pctx.moveTo(p.x, p.y);
            pctx.lineTo(particles[j].x, particles[j].y);
            pctx.strokeStyle = p.color;
            pctx.stroke();
          }
        }
        pctx.globalAlpha = 1;
      });
      requestAnimationFrame(drawParticles);
    }
    drawParticles();

    // SCROLL REVEAL + POWER BARS
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          var bars = e.target.querySelectorAll('.p-fill');
          bars.forEach(function(bar) { if (bar.dataset.width) bar.style.width = bar.dataset.width + '%'; });
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });

    var barObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          var fill = e.target.querySelector('.p-fill');
          if (fill && fill.dataset.width) fill.style.width = fill.dataset.width + '%';
          barObserver.unobserve(e.target);
        }
      });
    }, { threshold: 0.3 });
    document.querySelectorAll('.power-bar').forEach(function(el) { barObserver.observe(el); });

    // RESIZE
    window.addEventListener('resize', function() {
      mc.width = window.innerWidth; mc.height = window.innerHeight;
      pc.width = window.innerWidth; pc.height = window.innerHeight;
    });

    // PARALLAX on scroll
    window.addEventListener('scroll', function() {
      var scrollTop = window.pageYOffset;
      document.querySelectorAll('.hero-orb').forEach(function(orb, i) {
        orb.style.transform = 'translateY(' + (scrollTop * (0.1 + i * 0.05)) + 'px)';
      });
    });

    // POWER LEVEL BARS
    var barObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          var fill = e.target.querySelector('.bar-fill');
          if (fill && fill.dataset.width) {
            setTimeout(function() { fill.style.width = fill.dataset.width + '%'; }, 300);
          }
          barObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.3 });
    document.querySelectorAll('.power-row').forEach(function(el) { barObs.observe(el); });

    // ACTIVITY FEED ROTATION
    var activities = [
      { icon: '&#128737;', type: 'mod', text: '<strong>Anti-Scam</strong> blocked phishing link in <strong>#general</strong>' },
      { icon: '&#128176;', type: 'eco', text: '<strong>@User</strong> claimed daily reward of <strong>750 coins</strong>' },
      { icon: '&#128101;', type: 'join', text: '<strong>5 new members</strong> joined <strong>Gaming Hub</strong>' },
      { icon: '&#9889;', type: 'cmd', text: '<strong>@Mod</strong> used <span class="cmd-name">/ban</span> on spammer' },
      { icon: '&#128737;', type: 'prot', text: '<strong>Raid protection</strong> activated in <strong>Dev Community</strong>' },
      { icon: '&#127920;', type: 'eco', text: '<strong>@Gambler</strong> won <strong>2,500 coins</strong> on slots' },
      { icon: '&#128683;', type: 'mod', text: '<strong>Duplicate detection</strong> blocked spam in <strong>#chat</strong>' },
      { icon: '&#128176;', type: 'eco', text: '<strong>@Trader</strong> bought <strong>Diamond</strong> from shop' },
      { icon: '&#128101;', type: 'join', text: '<strong>@Newbie</strong> completed verification' },
      { icon: '&#11088;', type: 'cmd', text: '<strong>@User</strong> starred a message on <strong>#highlights</strong>' },
      { icon: '&#128737;', type: 'prot', text: '<strong>Account age gate</strong> blocked suspicious account' },
      { icon: '&#127873;', type: 'cmd', text: '<strong>Giveaway</strong> ended — <strong>@Winner</strong> won Nitro!' },
    ];
    var activityList = document.getElementById('activityList');
    var activityIdx = 0;
    setInterval(function() {
      var a = activities[activityIdx % activities.length];
      var item = document.createElement('div');
      item.className = 'activity-item';
      item.innerHTML = '<div class="a-icon ' + a.type + '">' + a.icon + '</div><div class="a-text">' + a.text + '</div><div class="a-time">now</div>';
      activityList.insertBefore(item, activityList.firstChild);
      if (activityList.children.length > 8) {
        activityList.removeChild(activityList.lastChild);
      }
      activityIdx++;
    }, 5000);

    // COMMAND PLAYGROUND
    var pgInput = document.getElementById('pgInput');
    var pgOutput = document.getElementById('pgOutput');
    var cmdResponses = {
      '/help': '<span class="pg-ok">&#10003;</span> <span class="pg-info">VARUNASTRA Commands:</span>\n  <span class="pg-dim">Moderation:</span> ban, kick, mute, warn, purge, tempban, nuke\n  <span class="pg-dim">Economy:</span> daily, balance, work, shop, buy, rob, slots\n  <span class="pg-dim">Social:</span> profile, rep, marry\n  <span class="pg-dim">Fun:</span> meme, cat, dog, trivia, 8ball, joke\n  <span class="pg-dim">Utility:</span> ping, help, avatar, userinfo, serverinfo\n  <span class="pg-dim">Security:</span> antiscam, raid, verification',
      '/ping': '<span class="pg-ok">&#10003;</span> Pong! Latency: <span class="pg-cmd">42ms</span> | WebSocket: <span class="pg-cmd">38ms</span>',
      '/daily': '<span class="pg-ok">&#10003;</span> You claimed <span class="pg-cmd">847 coins</span>! Come back in 24h for more.',
      '/balance': '<span class="pg-ok">&#10003;</span> Wallet: <span class="pg-cmd">12,450</span> | Bank: <span class="pg-cmd">45,200</span> | Total: <span class="pg-cmd">57,650</span>',
      '/work': '<span class="pg-ok">&#10003;</span> You worked as a <span class="pg-cmd">Cyber Hacker</span> and earned <span class="pg-cmd">320 coins</span>!',
      '/stats': '<span class="pg-ok">&#10003;</span> Servers: <span class="pg-cmd">150+</span> | Users: <span class="pg-cmd">50K+</span> | Commands: <span class="pg-cmd">120+</span> | Uptime: <span class="pg-cmd">99.9%</span>',
      '/8ball Will I be rich?': '<span class="pg-ok">&#10003;</span> &#127922; The ball says: <span class="pg-cmd">It is certain.</span>',
      '/meme': '<span class="pg-ok">&#10003;</span> Fetching meme from r/memes... <span class="pg-dim">[Image loaded]</span>',
      '/cat': '<span class="pg-ok">&#10003;</span> Here\'s a random cat! <span class="pg-dim">[meow.jpg loaded]</span>',
    };
    function addPgLine(html) {
      var line = document.createElement('div');
      line.className = 'pg-line';
      line.innerHTML = html;
      pgOutput.appendChild(line);
      pgOutput.scrollTop = pgOutput.scrollHeight;
    }
    function runCommand(cmd) {
      addPgLine('<span class="pg-prompt">$</span> <span class="pg-cmd">' + cmd + '</span>');
      var response = cmdResponses[cmd] || '<span class="pg-ok">&#10003;</span> <span class="pg-dim">Command "' + cmd.split(' ')[0] + '" executed successfully. Add the bot to try it live!</span>';
      setTimeout(function() { addPgLine(response); }, 300);
    }
    pgInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && pgInput.value.trim()) {
        runCommand(pgInput.value.trim());
        pgInput.value = '';
      }
    });
    document.querySelectorAll('.pg-hint').forEach(function(hint) {
      hint.addEventListener('click', function() {
        var cmd = hint.dataset.cmd;
        pgInput.value = cmd;
        runCommand(cmd);
        pgInput.value = '';
      });
    });
  </script>
</body>
</html>
