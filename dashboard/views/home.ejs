        <h4>Legal</h4>
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 VARUNASTRA. All rights reserved. Built with divine power.</p>
