  <script>
    // LOADING SCREEN
    window.addEventListener('load', function() {
      setTimeout(function() { document.getElementById('loader').classList.add('hidden'); }, 1500);
    });

    // SCROLL PROGRESS
    window.addEventListener('scroll', function() {
      var scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
      var scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      var progress = (scrollTop / scrollHeight) * 100;
      document.getElementById('scrollProgress').style.width = progress + '%';
    });

    // MOUSE SPOTLIGHT
    var spotlight = document.getElementById('spotlight');
    document.addEventListener('mousemove', function(e) {
      spotlight.style.left = e.clientX + 'px';
      spotlight.style.top = e.clientY + 'px';
    });

    // 3D TILT EFFECT ON CARDS
    document.querySelectorAll('[data-tilt]').forEach(function(card) {
      card.addEventListener('mousemove', function(e) {
        var rect = card.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var centerX = rect.width / 2;
        var centerY = rect.height / 2;
        var rotateX = (y - centerY) / 20;
        var rotateY = (centerX - x) / 20;
        card.style.transform = 'perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateZ(10px)';
      });
      card.addEventListener('mouseleave', function() {
        card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateZ(0)';
      });
    });

    // STATS
    fetch('/api/stats').then(function(r){return r.json()}).then(function(d){
      animateCounter('g', d.guilds);
      animateCounter('u', d.users, true);
      animateCounter('c', d.commands);
      animateCounter('sg', d.guilds);
      animateCounter('su', d.users, true);
      animateCounter('sc', d.commands);
      document.getElementById('statusGuilds').textContent = d.guilds;
    });

    // LIVE STATUS
    fetch('/api/bot/health').then(function(r){return r.json()}).then(function(d){
      document.getElementById('statusPing').textContent = d.ping + 'ms';
      document.getElementById('statusMemory').textContent = Math.round(d.memory.heap / 1024 / 1024) + 'MB';
      var uptime = d.uptime;
      var s = Math.floor(uptime / 1000);
      var m = Math.floor(s / 60);
      var h = Math.floor(m / 60);
      document.getElementById('statusUptime').textContent = h + 'h ' + (m % 60) + 'm';
    });

    // Refresh status every 30s
    setInterval(function() {
      fetch('/api/bot/health').then(function(r){return r.json()}).then(function(d){
        document.getElementById('statusPing').textContent = d.ping + 'ms';
        document.getElementById('statusMemory').textContent = Math.round(d.memory.heap / 1024 / 1024) + 'MB';
        var uptime = d.uptime;
        var s = Math.floor(uptime / 1000);
        var m = Math.floor(s / 60);
        var h = Math.floor(m / 60);
        document.getElementById('statusUptime').textContent = h + 'h ' + (m % 60) + 'm';
      });
    }, 30000);

    function animateCounter(id, target, comma) {
      var el = document.getElementById(id);
      if (!el) return;
      var duration = 2000;
      var start = performance.now();
      function update(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.floor(target * eased);
        el.textContent = comma ? current.toLocaleString() : current;
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }

    // COMMAND SEARCH
    var allCommands = [
      {n:'ban',d:'Ban a user from the server',c:'Moderation'},{n:'kick',d:'Kick a user from the server',c:'Moderation'},
      {n:'mute',d:'Mute a user for a duration',c:'Moderation'},{n:'unmute',d:'Unmute a user',c:'Moderation'},
      {n:'warn',d:'Warn a user',c:'Moderation'},{n:'warnings',d:'View user warnings',c:'Moderation'},
      {n:'purge',d:'Delete messages in bulk',c:'Moderation'},{n:'nick',d:'Change a user nickname',c:'Moderation'},
      {n:'slowmode',d:'Set channel slowmode',c:'Moderation'},{n:'lock',d:'Lock a channel',c:'Moderation'},
      {n:'unlock',d:'Unlock a channel',c:'Moderation'},{n:'tempban',d:'Temporarily ban a user',c:'Moderation'},
      {n:'massban',d:'Ban multiple users at once',c:'Moderation'},
      {n:'antiscam',d:'Configure anti-scam protection',c:'Security'},{n:'verification',d:'Setup verification system',c:'Security'},
      {n:'raid',d:'Configure raid protection',c:'Security'},
      {n:'balance',d:'Check your coin balance',c:'Economy'},{n:'daily',d:'Claim daily reward',c:'Economy'},
      {n:'work',d:'Work to earn coins',c:'Economy'},{n:'shop',d:'View the item shop',c:'Economy'},
      {n:'buy',d:'Buy an item from shop',c:'Economy'},{n:'pay',d:'Pay coins to another user',c:'Economy'},
      {n:'rob',d:'Rob another user',c:'Economy'},{n:'leaderboard',d:'View economy leaderboard',c:'Economy'},
      {n:'setup',d:'Quick setup wizard',c:'Setup'},{n:'setwelcome',d:'Set welcome channel & message',c:'Setup'},
      {n:'setgoodbye',d:'Set goodbye channel & message',c:'Setup'},{n:'setlog',d:'Set mod log channel',c:'Setup'},
      {n:'setprefix',d:'Change bot prefix',c:'Setup'},{n:'setautorole',d:'Set auto-role for new members',c:'Setup'},
      {n:'automod',d:'Configure auto-moderation',c:'Setup'},
      {n:'ping',d:'Check bot latency',c:'Utility'},{n:'help',d:'Show all commands',c:'Utility'},
      {n:'avatar',d:'Get user avatar',c:'Utility'},{n:'userinfo',d:'Get user information',c:'Utility'},
      {n:'serverinfo',d:'Get server information',c:'Utility'},{n:'botinfo',d:'Get bot information',c:'Utility'},
      {n:'uptime',d:'Check bot uptime',c:'Utility'},{n:'poll',d:'Create a poll',c:'Utility'},
      {n:'remind',d:'Set a reminder',c:'Utility'},{n:'msg',d:'Send message to a channel',c:'Utility'},
      {n:'weather',d:'Get weather info',c:'Utility'},{n:'base64',d:'Encode/decode base64',c:'Utility'},
      {n:'8ball',d:'Ask the magic 8-ball',c:'Fun'},{n:'roll',d:'Roll a dice',c:'Fun'},
      {n:'decide',d:'Let bot decide for you',c:'Fun'},{n:'say',d:'Bot says your message',c:'Fun'},
      {n:'reverse',d:'Reverse your text',c:'Fun'},{n:'coinflip',d:'Flip a coin',c:'Fun'},
      {n:'trivia',d:'Play trivia game',c:'Fun'},{n:'slot',d:'Play slot machine',c:'Fun'},
      {n:'meme',d:'Get a random meme',c:'Fun'},{n:'roast',d:'Roast a user',c:'Fun'},
      {n:'hack',d:'Fake hack a user',c:'Fun'},{n:'clap',d:'CLAP your text',c:'Fun'},
      {n:'ticket',d:'Setup ticket system',c:'Tickets'},{n:'giveaway',d:'Start a giveaway',c:'Giveaways'},
      {n:'addcommand',d:'Create a custom command',c:'Custom'},{n:'removecommand',d:'Delete a custom command',c:'Custom'},
      {n:'listcommands',d:'List all custom commands',c:'Custom'},{n:'reactionrole',d:'Setup reaction roles',c:'Custom'},
    ];

    var searchInput = document.getElementById('cmdSearch');
    var resultsDiv = document.getElementById('cmdResults');
    searchInput.addEventListener('input', function() {
      var q = this.value.toLowerCase().trim();
      if (!q) { resultsDiv.classList.remove('show'); resultsDiv.innerHTML = ''; return; }
      var matches = allCommands.filter(function(c) { return c.n.includes(q) || c.d.toLowerCase().includes(q) || c.c.toLowerCase().includes(q); }).slice(0, 9);
      if (matches.length === 0) { resultsDiv.classList.remove('show'); return; }
      resultsDiv.innerHTML = matches.map(function(c) {
        return '<div class="cmd-result" onclick="document.getElementById(\'cmdSearch\').value=\'' + c.n + '\';document.getElementById(\'cmdResults\').classList.remove(\'show\')"><div class="cmd-name">/' + c.n + '</div><div class="cmd-desc">' + c.d + ' &middot; ' + c.c + '</div></div>';
      }).join('');
      resultsDiv.classList.add('show');
    });

    // MATRIX RAIN
    var mc = document.getElementById('matrix-canvas');
    var mctx = mc.getContext('2d');
    mc.width = window.innerWidth;
    mc.height = window.innerHeight;
    var chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
    var fontSize = 14;
    var columns = Math.floor(mc.width / fontSize);
    var drops = Array(columns).fill(1);
    function drawMatrix() {
      mctx.fillStyle = 'rgba(3,3,8,0.04)';
      mctx.fillRect(0, 0, mc.width, mc.height);
      mctx.font = fontSize + 'px monospace';
      for (var i = 0; i < drops.length; i++) {
        var text = chars[Math.floor(Math.random() * chars.length)];
        mctx.fillStyle = Math.random() > 0.98 ? '#00f0ff' : Math.random() > 0.95 ? '#ec4899' : '#8b5cf6';
        mctx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > mc.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }
    setInterval(drawMatrix, 50);

    // PARTICLES (mouse reactive)
    var pc = document.getElementById('particle-canvas');
    var pctx = pc.getContext('2d');
    pc.width = window.innerWidth;
    pc.height = window.innerHeight;
    var particles = [];
    var mouseX = 0, mouseY = 0;
    document.addEventListener('mousemove', function(e) { mouseX = e.clientX; mouseY = e.clientY; });
    for (var i = 0; i < 80; i++) {
      particles.push({
        x: Math.random() * pc.width,
        y: Math.random() * pc.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        r: Math.random() * 2 + 0.5,
        color: ['#00f0ff', '#8b5cf6', '#ec4899'][Math.floor(Math.random() * 3)],
      });
    }
    function drawParticles() {
      pctx.clearRect(0, 0, pc.width, pc.height);
      particles.forEach(function(p, i) {
        // Mouse attraction
        var dx = mouseX - p.x;
        var dy = mouseY - p.y;
        var dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 200) {
          p.x += dx * 0.001;
          p.y += dy * 0.001;
        }
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = pc.width;
        if (p.x > pc.width) p.x = 0;
        if (p.y < 0) p.y = pc.height;
        if (p.y > pc.height) p.y = 0;
        pctx.beginPath();
        pctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        pctx.fillStyle = p.color;
        pctx.globalAlpha = 0.5;
        pctx.fill();
        pctx.globalAlpha = 0.08;
        for (var j = i + 1; j < particles.length; j++) {
          var ddx = p.x - particles[j].x;
          var ddy = p.y - particles[j].y;
          var ddist = Math.sqrt(ddx * ddx + ddy * ddy);
          if (ddist < 120) {
            pctx.beginPath();
            pctx.moveTo(p.x, p.y);
            pctx.lineTo(particles[j].x, particles[j].y);
            pctx.strokeStyle = p.color;
            pctx.stroke();
          }
        }
        pctx.globalAlpha = 1;
      });
      requestAnimationFrame(drawParticles);
    }
    drawParticles();

    // SCROLL REVEAL
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });

    // RESIZE
    window.addEventListener('resize', function() {
      mc.width = window.innerWidth; mc.height = window.innerHeight;
      pc.width = window.innerWidth; pc.height = window.innerHeight;
    });

    // PARALLAX on scroll
    window.addEventListener('scroll', function() {
      var scrollTop = window.pageYOffset;
      document.querySelectorAll('.hero-orb').forEach(function(orb, i) {
        orb.style.transform = 'translateY(' + (scrollTop * (0.1 + i * 0.05)) + 'px)';
      });
    });
  </script>
</body>
</html>
