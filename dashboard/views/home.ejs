<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bot Boy NOTIX Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    :root{--bg:#0a0a0f;--bg2:rgba(20,20,35,0.6);--bg3:rgba(25,25,40,0.6);--border:rgba(139,92,246,0.12);--border2:rgba(255,255,255,0.06);--text:#e8eaf0;--text2:#9ca3af;--text3:#6b7280;--accent:#8b5cf6;--accent2:#a78bfa;--accent3:#7c3aed;--green:#22c55e;--red:#ef4444;--pink:#ec4899;--r:16px;--rs:10px}
    body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    body::before{content:'';position:fixed;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(ellipse at 50% 0%,rgba(139,92,246,0.1),transparent 50%);pointer-events:none;z-index:0}
    a{color:var(--accent2);text-decoration:none;transition:color .2s}a:hover{color:var(--accent)}

    .nav{display:flex;justify-content:space-between;align-items:center;padding:0 2.5rem;height:64px;background:rgba(10,10,15,0.8);backdrop-filter:blur(24px);border-bottom:1px solid var(--border2);position:sticky;top:0;z-index:100}
    .nav .logo{font-weight:800;font-size:1.1rem;letter-spacing:-0.5px;display:flex;align-items:center;gap:0.6rem}
    .nav .logo span{background:linear-gradient(135deg,#8b5cf6,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .nav-r{display:flex;align-items:center;gap:0.8rem}
    .avatar{width:32px;height:32px;border-radius:50%;border:2px solid var(--accent)}

    .btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.6rem 1.4rem;border-radius:var(--rs);font-weight:600;font-size:0.85rem;cursor:pointer;border:none;transition:all .25s;font-family:inherit;letter-spacing:-0.1px;position:relative;overflow:hidden}
    .btn:active{transform:scale(0.97)}
    .btn-p{background:linear-gradient(135deg,var(--accent),var(--accent3));color:#fff;box-shadow:0 0 25px rgba(139,92,246,0.3)}.btn-p:hover{box-shadow:0 0 40px rgba(139,92,246,0.5);transform:translateY(-2px)}
    .btn-s{background:var(--bg3);color:var(--text);border:1px solid var(--border);backdrop-filter:blur(10px)}.btn-s:hover{background:var(--bg2);border-color:var(--accent);transform:translateY(-1px)}
    .btn-sm{padding:0.35rem 0.8rem;font-size:0.75rem}

    .hero{text-align:center;padding:8rem 2rem 6rem;position:relative;z-index:1}
    .hero::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(139,92,246,0.15),transparent 70%);pointer-events:none}
    .hero h1{font-size:4rem;font-weight:800;letter-spacing:-2px;background:linear-gradient(135deg,#fff 20%,#8b5cf6 50%,#ec4899 80%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:0.6rem;line-height:1.1}
    .hero p{font-size:1.15rem;color:var(--text2);margin-bottom:3rem;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.6}
    .hero-stats{display:flex;justify-content:center;gap:5rem;margin-bottom:3.5rem}
    .hero-stats .s{position:relative}
    .hero-stats .s span{display:block;font-size:3rem;font-weight:800;background:linear-gradient(135deg,var(--accent2),var(--pink));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .hero-stats .s p{font-size:0.78rem;color:var(--text3);text-transform:uppercase;letter-spacing:1.5px;font-weight:600;margin-top:0.3rem}
    .hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
    .hero-btns .btn{font-size:0.92rem;padding:0.8rem 2.2rem;border-radius:12px}

    .feat-section{max-width:1100px;margin:0 auto 5rem;padding:0 2rem;position:relative;z-index:1}
    .feat-section h2{text-align:center;font-size:2rem;font-weight:800;letter-spacing:-1px;margin-bottom:0.5rem}
    .feat-section .sub{text-align:center;color:var(--text2);margin-bottom:3rem;font-size:1rem}
    .feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}
    .feat{background:rgba(20,20,35,0.6);border:1px solid var(--border);border-radius:var(--r);padding:1.8rem 1.4rem;text-align:center;transition:all .3s;backdrop-filter:blur(10px);position:relative;overflow:hidden}
    .feat::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:50%;height:1px;background:linear-gradient(90deg,transparent,var(--accent),transparent);opacity:0;transition:opacity .3s}
    .feat:hover{border-color:rgba(139,92,246,0.3);transform:translateY(-4px);box-shadow:0 12px 40px rgba(139,92,246,0.1)}.feat:hover::before{opacity:1}
    .feat .icon{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,rgba(139,92,246,0.2),rgba(236,72,153,0.2));display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 1rem;border:1px solid rgba(139,92,246,0.2);transition:all .3s}
    .feat:hover .icon{background:linear-gradient(135deg,rgba(139,92,246,0.3),rgba(236,72,153,0.3));transform:scale(1.1);box-shadow:0 0 20px rgba(139,92,246,0.2)}
    .feat h3{font-size:0.88rem;margin-bottom:0.4rem;font-weight:600}.feat p{font-size:0.78rem;color:var(--text3);line-height:1.5}

    .sg{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.2rem}
    .sc{background:rgba(20,20,35,0.6);border:1px solid var(--border);border-radius:var(--r);padding:1.8rem 1.5rem;text-align:center;text-decoration:none;color:var(--text);transition:all .3s;backdrop-filter:blur(10px)}
    .sc:hover{border-color:var(--accent);transform:translateY(-4px);box-shadow:0 12px 40px rgba(139,92,246,0.15)}
    .sc img{width:68px;height:68px;border-radius:50%;margin-bottom:1rem;border:3px solid var(--border)}.sc:hover img{border-color:var(--accent)}
    .sc .ph{width:68px;height:68px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--pink));display:flex;align-items:center;justify-content:center;font-size:1.6rem;font-weight:700;margin:0 auto 1rem;box-shadow:0 0 20px rgba(139,92,246,0.3)}
    .sc h3{font-size:0.95rem;margin-bottom:0.4rem}

    .footer{text-align:center;padding:3rem 2rem;border-top:1px solid var(--border2);color:var(--text3);font-size:0.8rem;position:relative;z-index:1}

    ::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(139,92,246,0.3);border-radius:3px}
    @media(max-width:900px){.feat-grid{grid-template-columns:repeat(2,1fr)}.hero h1{font-size:2.5rem}.hero-stats{gap:2.5rem}.hero-stats .s span{font-size:2rem}}
    @media(max-width:600px){.feat-grid{grid-template-columns:1fr}.hero h1{font-size:2rem}.hero-stats{flex-direction:column;gap:1.5rem}.nav{padding:0 1.2rem}}
  </style>
</head>
<body>
  <div class="nav">
    <a href="/" class="logo"><span>Bot Boy NOTIX</span></a>
    <div class="nav-r">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-p btn-sm">Dashboard</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-p btn-sm">Login</a>
      <% } %>
    </div>
  </div>

  <div class="hero">
    <h1>Your Discord adventure<br>starts here</h1>
    <p>Manage your server, connect with your community, and unlock new possibilities — all in one place.</p>
    <div class="hero-stats">
      <div class="s"><span id="g">0</span><p>Guilds</p></div>
      <div class="s"><span id="u">0</span><p>Users</p></div>
      <div class="s"><span id="c">0</span><p>Commands</p></div>
    </div>
    <div class="hero-btns">
      <% if (user) { %><a href="/dashboard" class="btn btn-p">Open Dashboard</a><% } else { %><a href="/auth/login" class="btn btn-p">Login with Discord</a><% } %>
      <a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-s">Add to Server</a>
    </div>
  </div>

  <div class="feat-section">
    <h2>Everything you need</h2>
    <p class="sub">Powerful features to manage and grow your Discord server</p>
    <div class="feat-grid">
      <div class="feat"><div class="icon">&#128737;</div><h3>Moderation</h3><p>Kick, ban, mute, warn, purge, slowmode</p></div>
      <div class="feat"><div class="icon">&#128075;</div><h3>Welcome / Goodbye</h3><p>Custom embeds, images, auto-roles</p></div>
      <div class="feat"><div class="icon">&#128737;</div><h3>Auto-Moderation</h3><p>Anti-spam, anti-link, anti-raid, anti-scam</p></div>
      <div class="feat"><div class="icon">&#128200;</div><h3>Leveling</h3><p>XP system, leaderboards, level-up alerts</p></div>
      <div class="feat"><div class="icon">&#11088;</div><h3>Starboard</h3><p>Feature best messages with star reactions</p></div>
      <div class="feat"><div class="icon">&#128203;</div><h3>Logging</h3><p>Message edits, deletes, joins, bans</p></div>
      <div class="feat"><div class="icon">&#128279;</div><h3>Invite Tracker</h3><p>See who invites the most members</p></div>
      <div class="feat"><div class="icon">&#127912;</div><h3>Embed Builder</h3><p>Build and send custom embeds live</p></div>
      <div class="feat"><div class="icon">&#9889;</div><h3>Custom Commands</h3><p>Create your own bot commands</p></div>
      <div class="feat"><div class="icon">&#127917;</div><h3>Reaction Roles</h3><p>Self-assignable roles via emoji</p></div>
      <div class="feat"><div class="icon">&#128202;</div><h3>Polls</h3><p>Interactive polls with reactions</p></div>
      <div class="feat"><div class="icon">&#127760;</div><h3>Web Dashboard</h3><p>Configure everything online</p></div>
    </div>
  </div>

  <div class="footer">
    <p>Bot Boy NOTIX &copy; 2026 — Built with Discord.js</p>
  </div>

  <script>fetch('/api/stats').then(r=>r.json()).then(d=>{document.getElementById('g').textContent=d.guilds;document.getElementById('u').textContent=d.users.toLocaleString();document.getElementById('c').textContent=d.commands})</script>
</body>
</html>
