<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Commands - <%= guild.name %> — VARUNASTRA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="nav"><a href="/" class="logo"><span class="pulse-dot"></span><span>VARUNASTRA</span></a><div class="nav-r"><span style="font-size:0.85rem;font-weight:500;"><%= user.username %></span></div></div>
  <div class="layout" data-guild="<%= guild.id %>">
    <%- include('partials/sidebar') %>
    <div class="main">
      <h1>&#9889; Custom Commands</h1>
      <p class="sub">Create your own bot commands.</p>
      <div class="card">
        <div class="card-h"><h2>&#10133; New Command</h2></div>
        <form action="/dashboard/<%= guild.id %>/commands/add" method="POST" style="display:flex;gap:0.8rem;align-items:flex-end;flex-wrap:wrap;">
          <div class="field" style="flex:1;min-width:120px;margin:0;"><label>Name</label><input type="text" name="name" placeholder="hello" required><small><%= settings.prefix %>hello</small></div>
          <div class="field" style="flex:3;min-width:200px;margin:0;"><label>Response</label><input type="text" name="response" placeholder="Hello {user}!" required><small>Use {user} to mention</small></div>
          <button type="submit" class="btn btn-p" style="height:36px;">Add</button>
        </form>
      </div>
      <div class="card">
        <div class="card-h"><h2>&#128196; Commands</h2><span class="badge b-blue"><%= customCommands.length %></span></div>
        <% if (!customCommands.length) { %><div class="empty"><div class="ic">&#9889;</div><h3>No commands yet</h3></div><% } else { %>
          <table class="tbl"><thead><tr><th>Command</th><th>Response</th><th></th></tr></thead><tbody>
          <% customCommands.forEach(cmd => { %><tr><td><strong><%= settings.prefix %><%= cmd.name %></strong></td><td style="max-width:400px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= cmd.response %></td><td style="text-align:right;"><form action="/dashboard/<%= guild.id %>/commands/remove" method="POST" style="display:inline;"><input type="hidden" name="name" value="<%= cmd.name %>"><button type="submit" class="btn btn-d btn-sm">&#128465;</button></form></td></tr><% }); %>
          </tbody></table>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
