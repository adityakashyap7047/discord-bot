<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Starboard - <%= guild.name %> — VARUNASTRA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="nav"><a href="/" class="logo"><span class="pulse-dot"></span><span>VARUNASTRA</span></a><div class="nav-r"><span style="font-size:0.85rem;font-weight:500;"><%= user.username %></span></div></div>
  <div class="layout" data-guild="<%= guild.id %>">
    <%- include('partials/sidebar') %>
    <div class="main">
      <h1>&#11088; Starboard</h1>
      <p class="sub">Feature the best messages with stars.</p>
      <div class="card">
        <div class="card-h"><h2>&#11088; Settings</h2><span class="badge <%= settings.starboardEnabled ? 'b-green' : 'b-red' %>"><%= settings.starboardEnabled ? 'ON' : 'OFF' %></span></div>
        <div class="sw"><div class="info"><div class="t">Enable Starboard</div><div class="d">Star messages to feature them</div></div><label class="toggle"><input type="checkbox" <%= settings.starboardEnabled ? 'checked' : '' %> data-auto="starboardEnabled"><span class="sl"></span></label></div>
        <div class="field" style="margin-top:1rem;"><label>Channel</label><select data-auto="starboardChannel"><option value="">Select</option><% channels.forEach(ch => { %><option value="<%= ch.id %>" <%= settings.starboardChannel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option><% }); %></select></div>
        <div class="field"><label>Star Threshold</label><input type="number" value="<%= settings.starboardThreshold || 3 %>" min="1" max="50" data-auto="starboardThreshold"><small>Reactions needed to star</small></div>
      </div>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
