<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Server - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/" class="logo">🤖 Bot Dashboard</a>
    <div class="nav-right">
      <span><%= user.username %></span>
      <a href="/auth/logout" class="btn secondary small">Logout</a>
    </div>
  </nav>
  <div class="main" style="max-width:1000px;margin:2rem auto;padding:0 2rem;">
    <h1>Select a Server</h1>
    <p style="color:var(--text-secondary);margin-bottom:2rem;">Choose a server where you have Manage Server permissions.</p>
    <div class="server-grid">
      <% guilds.forEach(guild => { %>
        <a href="/dashboard/<%= guild.id %>" class="server-card">
          <% if (guild.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" class="server-icon" alt="">
          <% } else { %>
            <div class="server-icon-placeholder"><%= guild.name.charAt(0) %></div>
          <% } %>
          <h3><%= guild.name %></h3>
        </a>
      <% }); %>
    </div>
    <% if (guilds.length === 0) { %>
      <div class="empty"><h3>No servers found</h3><p>Make sure the bot is in your server and you have Manage Server permissions.</p></div>
    <% } %>
  </div>
</body>
</html>
