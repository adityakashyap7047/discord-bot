<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Select Server</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="navbar">
    <a href="/" class="logo">&#129302; Bot Dashboard</a>
    <div class="navbar-right">
      <div class="user"><img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt=""><span><%= user.username %></span></div>
      <a href="/auth/logout" class="btn btn-secondary btn-sm">Logout</a>
    </div>
  </div>
  <div class="main" style="max-width:900px;margin:2rem auto;">
    <h1>Select a Server</h1>
    <p class="subtitle">Choose a server where you have Manage Server permissions.</p>
    <div class="server-grid">
      <% guilds.forEach(g => { %>
        <a href="/dashboard/<%= g.id %>" class="server-card">
          <% if (g.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="">
          <% } else { %>
            <div class="placeholder"><%= g.name.charAt(0) %></div>
          <% } %>
          <h3><%= g.name %></h3>
        </a>
      <% }); %>
    </div>
    <% if (!guilds.length) { %><div class="empty"><div class="icon">&#128194;</div><h3>No servers found</h3><p>The bot must be in your server and you need Manage Server permission.</p></div><% } %>
  </div>
</body>
</html>
