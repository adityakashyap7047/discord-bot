<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Server — VARUNASTRA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="cyber-grid"></div>
  <canvas id="matrix-canvas"></canvas>
  <canvas id="particle-canvas"></canvas>
  <div class="scanlines"></div>

  <div class="nav">
    <a href="/" class="logo"><span class="pulse-dot"></span><span>VARUNASTRA</span></a>
    <div class="nav-r">
      <div style="display:flex;align-items:center;gap:0.6rem;">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" class="avatar" alt="">
        <span style="font-size:0.85rem;font-weight:500;"><%= user.username %></span>
      </div>
      <a href="/auth/logout" class="btn btn-s btn-sm">Logout</a>
    </div>
  </div>

  <div class="main" style="max-width:950px;margin:2.5rem auto;">
    <h1>Select a Server</h1>
    <p class="sub">Choose a server to configure. You need Manage Server permission.</p>

    <div class="card" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.8rem;">
      <span style="font-size:0.88rem;"><strong>Don't see your server?</strong> <span style="color:var(--text2);">Add the bot first.</span></span>
      <a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-p btn-sm">Add Bot</a>
    </div>

    <div class="sg">
      <% guilds.forEach(g => { %>
        <div class="sc reveal" style="<%= !g.botInServer ? 'opacity:0.4;' : '' %>">
          <% if (g.icon) { %><img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt=""><% } else { %><div class="ph"><%= g.name.charAt(0) %></div><% } %>
          <h3><%= g.name %></h3>
          <div class="sc-meta"><%= g.botInServer ? 'Bot Active' : 'Bot Not Installed' %></div>
          <% if (g.botInServer) { %>
            <a href="/dashboard/<%= g.id %>" class="btn btn-p btn-sm" style="margin-top:1rem;width:100%;justify-content:center;">Configure</a>
          <% } else { %>
            <a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= g.id %>" target="_blank" class="btn btn-s btn-sm" style="margin-top:1rem;width:100%;justify-content:center;">Add Bot</a>
          <% } %>
        </div>
      <% }); %>
    </div>
    <% if (!guilds.length) { %><div class="empty"><div class="ic">&#128194;</div><h3>No servers found</h3><p>You need Manage Server permission on a server.</p><a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-p" style="margin-top:1rem;">Add Bot to a Server</a></div><% } %>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
