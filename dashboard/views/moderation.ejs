<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moderation - <%= guild.name %> — VARUNASTRA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="nav"><a href="/" class="logo"><span class="pulse-dot"></span><span>VARUNASTRA</span></a><div class="nav-r"><span style="font-size:0.85rem;font-weight:500;"><%= user.username %></span></div></div>
  <div class="layout" data-guild="<%= guild.id %>">
    <%- include('partials/sidebar') %>
    <div class="main">
      <h1>&#128737; Moderation</h1>
      <p class="sub">Auto-moderation and moderation tools. Toggle features on/off instantly.</p>
      <% if (typeof query !== 'undefined' && query.error) { %><p class="sub" style="color:#f87171"><%= query.error %></p><% } %>
      <% if (typeof query !== 'undefined' && query.sent) { %><p class="sub" style="color:#4ade80"><%= query.sent %></p><% } %>
      <div class="card">
        <div class="card-h"><h2>&#128293; Auto-Moderation</h2><span class="badge <%= settings.autoMod || settings.antiSpam || settings.antiLink ? 'b-green' : 'b-red' %>"><%= settings.autoMod || settings.antiSpam || settings.antiLink ? 'Active' : 'Off' %></span></div>
        <div class="sw"><div class="info"><div class="t">&#128172; Bad Word Filter</div><div class="d">Delete messages with banned words</div></div><label class="toggle"><input type="checkbox" <%= settings.autoMod ? 'checked' : '' %> data-auto="autoMod"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#9889; Anti-Spam</div><div class="d">Prevent message flooding</div></div><label class="toggle"><input type="checkbox" <%= settings.antiSpam ? 'checked' : '' %> data-auto="antiSpam"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#128279; Anti-Link</div><div class="d">Block links from non-mods</div></div><label class="toggle"><input type="checkbox" <%= settings.antiLink ? 'checked' : '' %> data-auto="antiLink"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#128163; Anti-Raid</div><div class="d">Protect against mass-join raids</div></div><label class="toggle"><input type="checkbox" <%= settings.antiRaid ? 'checked' : '' %> data-auto="antiRaid"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#128683; Anti-Scam</div><div class="d">Block crypto scams and phishing</div></div><label class="toggle"><input type="checkbox" <%= settings.antiScam ? 'checked' : '' %> data-auto="antiScam"><span class="sl"></span></label></div>
        <div class="row r2" style="margin-top:1.2rem;">
          <div class="field"><label>Flood Limit (msgs)</label><input type="number" value="<%= settings.floodLimit || 5 %>" min="2" max="20" data-auto="floodLimit"></div>
          <div class="field"><label>Flood Timeframe (sec)</label><input type="number" value="<%= settings.floodTimeframe || 5 %>" min="2" max="30" data-auto="floodTimeframe"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-h"><h2>&#128263; Mute Role</h2></div>
        <div class="field"><label>Role assigned when muting</label><select data-auto="mutedRole"><option value="">None</option><% roles.forEach(r => { %><option value="<%= r.id %>" <%= settings.mutedRole === r.id ? 'selected' : '' %>><%= r.name %></option><% }); %></select></div>
      </div>

      <div class="card">
        <div class="card-h"><h2>&#128683; Scam Protection</h2></div>
        <div class="sw"><div class="info"><div class="t">&#128683; Anti-Scam</div><div class="d">Block crypto scams and phishing attempts</div></div><label class="toggle"><input type="checkbox" <%= settings.antiScam ? 'checked' : '' %> data-auto="antiScam"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#128269; Link Reputation Check</div><div class="d">Check URLs against known scam databases</div></div><label class="toggle"><input type="checkbox" <%= settings.linkReputationCheck ? 'checked' : '' %> data-auto="linkReputationCheck"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#128100; Suspicious Username Detection</div><div class="d">Flag accounts with suspicious names</div></div><label class="toggle"><input type="checkbox" <%= settings.suspiciousUsernameDetection ? 'checked' : '' %> data-auto="suspiciousUsernameDetection"><span class="sl"></span></label></div>
        <div class="sw"><div class="info"><div class="t">&#128203; Duplicate Message Detection</div><div class="d">Block repeated messages across channels</div></div><label class="toggle"><input type="checkbox" <%= settings.duplicateDetection ? 'checked' : '' %> data-auto="duplicateDetection"><span class="sl"></span></label></div>
        <div class="field"><label>Mass Mention Limit</label><input type="number" value="<%= settings.massMentionLimit || 5 %>" min="1" max="20" data-auto="massMentionLimit"><small>Max mentions per message (0 = disabled)</small></div>
        <div class="field"><label>Scam Action</label><select data-auto="scamAction"><option value="delete" <%= settings.scamAction === 'delete' ? 'selected' : '' %>>Delete Only</option><option value="mute" <%= settings.scamAction === 'mute' ? 'selected' : '' %>>Delete + Mute</option><option value="kick" <%= settings.scamAction === 'kick' ? 'selected' : '' %>>Delete + Kick</option><option value="ban" <%= settings.scamAction === 'ban' ? 'selected' : '' %>>Delete + Ban</option></select></div>
        <div class="field"><label>Scam Log Channel</label><select data-auto="scamLogChannel"><option value="">Select</option><% channels.forEach(ch => { %><option value="<%= ch.id %>" <%= settings.scamLogChannel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option><% }); %></select></div>
        <form action="/dashboard/<%= guild.id %>/test-message/moderation" method="POST"><button type="submit" class="btn btn-s">🧪 Send Test Moderation Alert</button></form>
      </div>

      <div class="card">
        <div class="card-h"><h2>&#128737; Raid Protection</h2><span class="badge <%= settings.raidProtection ? 'b-green' : 'b-red' %>"><%= settings.raidProtection ? 'ON' : 'OFF' %></span></div>
        <div class="sw"><div class="info"><div class="t">&#128163; Enable Raid Protection</div><div class="d">Auto-lockdown when too many accounts join</div></div><label class="toggle"><input type="checkbox" <%= settings.raidProtection ? 'checked' : '' %> data-auto="raidProtection"><span class="sl"></span></label></div>
        <div class="row r2" style="margin-top:1rem;">
          <div class="field"><label>Threshold (joins)</label><input type="number" value="<%= settings.raidThreshold || 5 %>" min="2" max="50" data-auto="raidThreshold"></div>
          <div class="field"><label>Timeframe (seconds)</label><input type="number" value="<%= settings.raidTimeframe || 60 %>" min="10" max="300" data-auto="raidTimeframe"></div>
        </div>
        <div class="field"><label>Lockdown Duration (minutes)</label><input type="number" value="<%= (settings.raidLockdownDuration || 300000) / 60000 %>" min="1" max="60" data-auto="raidLockdownDuration"><small>Auto-unlock after this time</small></div>
      </div>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
