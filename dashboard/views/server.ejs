<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/" class="logo">🤖 Bot</a>
    <div class="nav-right"><span><%= user.username %></span><a href="/auth/logout" class="btn secondary small">Logout</a></div>
  </nav>
  <div class="layout">
    <%- include('partials/sidebar') %>
    <div class="main">
      <% if (typeof saved !== 'undefined' && saved) { %><div class="alert success">Settings saved successfully!</div><% } %>
      <h1>⚙️ General Settings</h1>
      <p style="color:var(--text-secondary);margin-bottom:1.5rem;">Configure basic bot settings for this server.</p>

      <div class="stats-grid">
        <div class="stat-card"><div class="number"><%= stats.warnings %></div><div class="label">Warnings</div></div>
        <div class="stat-card"><div class="number"><%= stats.customCommands %></div><div class="label">Custom Commands</div></div>
        <div class="stat-card"><div class="number"><%= stats.reactionRoles %></div><div class="label">Reaction Roles</div></div>
        <div class="stat-card"><div class="number"><%= stats.levels %></div><div class="label">Leveled Users</div></div>
        <div class="stat-card"><div class="number"><%= guild.memberCount %></div><div class="label">Members</div></div>
        <div class="stat-card"><div class="number"><%= guild.channels.cache.size %></div><div class="label">Channels</div></div>
      </div>

      <form action="/dashboard/<%= guild.id %>/update" method="POST">
        <div class="card">
          <h2>🔧 General</h2>
          <div class="field">
            <label>Bot Prefix</label>
            <input type="text" name="prefix" value="<%= settings.prefix || '!' %>" maxlength="5" style="width:100px;">
            <small>The prefix for text commands (default: !)</small>
          </div>
        </div>

        <div class="card">
          <h2>🏷️ Auto Role</h2>
          <div class="field">
            <label>
              <input type="checkbox" name="autoroleEnabled" <%= settings.autoroleEnabled ? 'checked' : '' %>> Enable Auto Role
            </label>
          </div>
          <div class="field">
            <label>Role to assign to new members</label>
            <select name="autoroleId">
              <option value="">None</option>
              <% roles.forEach(r => { %>
                <option value="<%= r.id %>" <%= settings.autoroleId === r.id ? 'selected' : '' %>><%= r.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="card">
          <h2>⚡ Disabled Commands</h2>
          <div class="field">
            <small>Select commands to disable in this server (not yet implemented)</small>
          </div>
        </div>

        <button type="submit" class="btn primary" style="margin-top:1rem;">Save Settings</button>
      </form>
    </div>
  </div>
</body>
</html>
