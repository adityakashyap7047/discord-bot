<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reaction Roles - <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="navbar">
    <a href="/" class="logo">&#129302; Bot Dashboard</a>
    <div class="navbar-right"><div class="user"><span><%= user.username %></span></div></div>
  </div>
  <div class="layout" data-guild="<%= guild.id %>">
    <%- include('partials/sidebar') %>
    <div class="main">
      <h1>&#127917; Reaction Roles</h1>
      <p class="subtitle">Self-assignable roles via emoji reactions.</p>

      <div class="card">
        <div class="card-header"><h2>&#128221; How to Create</h2></div>
        <div style="font-size:0.88rem;color:var(--text2);line-height:1.8;">
          <p>1. Send a message in the channel where you want reaction roles</p>
          <p>2. Copy the message ID (enable Developer Mode in Discord settings)</p>
          <p>3. Use in Discord: <code style="background:var(--bg);padding:0.2rem 0.5rem;border-radius:4px;">reactionrole #channel &lt;messageId&gt; &#127917; @role</code></p>
          <p>4. The bot adds the reaction and assigns the role on click</p>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><h2>&#128101; Active Reaction Roles</h2><span class="badge badge-blue"><%= reactionRoles.length %></span></div>
        <% if (!reactionRoles.length) { %>
          <div class="empty"><div class="icon">&#127917;</div><h3>No reaction roles yet</h3></div>
        <% } else { %>
          <table class="tbl">
            <thead><tr><th>Channel</th><th>Message</th><th>Emoji</th><th>Role</th></tr></thead>
            <tbody>
              <% reactionRoles.forEach(rr => { %>
                <tr>
                  <td><%= rr.channelId %></td>
                  <td style="font-family:monospace;font-size:0.8rem;"><%= rr.messageId %></td>
                  <td><%= rr.emoji %></td>
                  <td><%= rr.roleId %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
