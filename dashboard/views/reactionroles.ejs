<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reaction Roles - <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/" class="logo">🤖 Bot</a>
    <div class="nav-right"><span><%= user.username %></span><a href="/auth/logout" class="btn secondary small">Logout</a></div>
  </nav>
  <div class="layout">
    <%- include('partials/sidebar') %>
    <div class="main">
      <h1>🎭 Reaction Roles</h1>
      <p style="color:var(--text-secondary);margin-bottom:1.5rem;">Create reaction role messages for self-assignable roles.</p>

      <div class="card">
        <h2>ℹ️ How to Create</h2>
        <p style="color:var(--text-secondary);font-size:0.9rem;">
          1. Use <code>reactionrole #channel &lt;messageId&gt; &lt;emoji&gt; @role</code> in Discord<br>
          2. The bot will add the reaction to the message<br>
          3. When users react, they get the role; when they unreact, the role is removed
        </p>
      </div>

      <div class="card">
        <h2>📋 Active Reaction Roles</h2>
        <% if (reactionRoles.length === 0) { %>
          <div class="empty"><p>No reaction roles configured yet. Use the command in Discord to set one up.</p></div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Channel</th><th>Message ID</th><th>Emoji</th><th>Role</th></tr></thead>
              <tbody>
                <% reactionRoles.forEach(rr => { %>
                  <tr>
                    <td><%= rr.channelId %></td>
                    <td><%= rr.messageId %></td>
                    <td><%= rr.emoji %></td>
                    <td><%= rr.roleId %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
