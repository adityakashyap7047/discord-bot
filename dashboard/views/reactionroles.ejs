<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reaction Roles - <%= guild.name %> — VARUNASTRA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="nav"><a href="/" class="logo"><span class="pulse-dot"></span><span>VARUNASTRA</span></a><div class="nav-r"><span style="font-size:0.85rem;font-weight:500;"><%= user.username %></span></div></div>
  <div class="layout" data-guild="<%= guild.id %>">
    <%- include('partials/sidebar') %>
    <div class="main">
      <h1>&#127917; Reaction Roles</h1>
      <p class="sub">Self-assignable roles via emoji reactions.</p>
      <div class="card">
        <div class="card-h"><h2>&#128221; How to Create</h2></div>
        <div style="font-size:0.85rem;color:var(--text2);line-height:2;">
          <p>1. Send a message in your desired channel</p>
          <p>2. Copy the message ID (Developer Mode in Discord settings)</p>
          <p>3. Use: <code style="background:var(--bg);padding:0.2rem 0.5rem;border-radius:4px;">reactionrole #channel &lt;messageId&gt; &#127917; @role</code></p>
          <p>4. Bot adds reaction, assigns role on click</p>
        </div>
      </div>
      <div class="card">
        <div class="card-h"><h2>&#128101; Active</h2><span class="badge b-blue"><%= reactionRoles.length %></span></div>
        <% if (!reactionRoles.length) { %><div class="empty"><div class="ic">&#127917;</div><h3>No reaction roles yet</h3></div><% } else { %>
          <table class="tbl"><thead><tr><th>Channel</th><th>Message</th><th>Emoji</th><th>Role</th></tr></thead><tbody>
          <% reactionRoles.forEach(rr => { %><tr><td><%= rr.channelId %></td><td style="font-family:monospace;font-size:0.78rem;"><%= rr.messageId %></td><td><%= rr.emoji %></td><td><%= rr.roleId %></td></tr><% }); %>
          </tbody></table>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
